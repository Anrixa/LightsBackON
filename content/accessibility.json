{
  "_note": "A04. Presentation preferences and a non-spoiler, event-driven first-repair tutorial; no authoritative gameplay changes.",
  "settings_schema": 1,
  "defaults": {
    "ui_scale_percent": 100,
    "reduce_camera_motion": true,
    "reduce_flashes": true,
    "hints_enabled": true,
    "render_scale_percent": 0
  },
  "ui_scale_percent": {
    "min": 80,
    "max": 150,
    "step": 10
  },
  "render_scale_percent": {
    "_note": "DS09 (owner decision 9 Nov 2026): 3D resolution as a percentage of the window, bilinear scaling_3d on the root viewport; the HUD and menus stay at native resolution. 0 = Auto: the largest option whose 3D pixel count stays within auto_max_render_pixels (1920x1200), so a 2560x1600 laptop panel renders at 75 % and a 1080p screen at 100 %. Older profiles without this key read as Auto.",
    "options": [
      0,
      100,
      85,
      75,
      50
    ],
    "auto": 0,
    "auto_max_render_pixels": 2304000
  },
  "idle_hint_seconds": [
    20,
    45,
    90
  ],
  "steps": [
    {
      "id": "MOVE",
      "event": "player_moved",
      "text_key": "guide.step.move",
      "hint_keys": [
        "guide.hint.move.1",
        "guide.hint.move.2",
        "guide.hint.move.3"
      ]
    },
    {
      "id": "MEASURE",
      "event": "meter_measured",
      "text_key": "guide.step.measure",
      "hint_keys": [
        "guide.hint.measure.1",
        "guide.hint.measure.2",
        "guide.hint.measure.3"
      ],
      "bindings": [
        {
          "kbm": "tool_slot_1",
          "pad": "tool_next"
        },
        {
          "kbm": "interact",
          "pad": "interact"
        }
      ]
    },
    {
      "id": "ISOLATE",
      "event": "junction_isolated",
      "text_key": "guide.step.isolate",
      "hint_keys": [
        "guide.hint.isolate.1",
        "guide.hint.isolate.2",
        "guide.hint.isolate.3"
      ]
    },
    {
      "id": "REPAIR",
      "event": "repair_restored",
      "text_key": "guide.step.repair",
      "hint_keys": [
        "guide.hint.repair.1",
        "guide.hint.repair.2",
        "guide.hint.repair.3"
      ]
    }
  ]
}
