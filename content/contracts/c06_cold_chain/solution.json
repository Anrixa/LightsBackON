      "note": "Before pumping, neither flooded repair room may be accessed."
    },
    {
      "as": "P1",
      "intent": "request_lock",
      "entity": "R_DOCK_FUSE",
      "payload": {},
      "expect": "NO_ACCESS"
    },
    {
      "as": "P1",
      "intent": "request_lock",
      "entity": "R_COLD_FEED",
      "payload": {},
      "expect": "NO_ACCESS"
    },
    {
      "as": "P1",
      "intent": "place_item",
      "entity": "GEN_PORTABLE",
      "payload": {
        "action": "pickup"
      },
      "expect": "ok"
    },
    {
      "as": "P1",
      "intent": "place_item",
      "entity": "GEN_PORTABLE",
      "payload": {
        "action": "place",
        "anchor": "PAD_CANAL_PUMPS"
      },
      "expect": "ok"
    },
