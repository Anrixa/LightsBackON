{
  "contract_id": "C06",
  "source_note": "C06 Cold-Chain Window: original CT-L2 Canal Yard headless logic authoring under ADR-017. The primary blueprint C06 sheet was not available for verification; all C06 PU, 280-tick grace period and title are provisional design choices requiring original-sheet reconciliation. Not a physically playable district. 62 host-intent steps supply both pumps sequentially, repair two independently accessed feeders, switch the optional 5 PU cold store on before the grace deadline, maintain four mandatory consumers for 100 ticks, stow generator and extract.",
  "players": [
    "P1"
  ],
  "tools": [
    "screwdriver",
    "puller",
    "cutter",
    "crimper",
    "meter"
  ],
  "max_ticks": 700,
  "pace_ticks_per_command": 1,
  "steps": [
