static func _reject(code: String) -> Dictionary:
	return {"ok": false, "code": code, "qualification": QUALIFICATION}


## Bind the read-only scene to one exact source plan, one case and the A03
## regional vignette. All task identities must already be present in the atlas.
static func inspect(plan: Dictionary, case_source: Dictionary,
		regional: Node3D) -> Dictionary:
	var geometry: Dictionary = Regional.inspect(plan)
	if not bool(geometry.get("ok", false)):
		return _reject("EXP014_A04_GEOMETRY_SOURCE_INVALID")
	if regional == null or not bool(regional.get_meta("presentation_only", false)):
		return _reject("EXP014_A04_MISSING_REGION_SCENE")
	for key: String in ["level_id", "location_id", "region_id"]:
		if str(case_source.get(key, "")) != str(
				plan["id"] if key == "level_id" else plan[key]):
			return _reject("EXP014_A04_CASE_IDENTITY_DRIFT")
	if str(case_source.get("source_risk", "")) != str(plan["hazard"]) or \
			case_source.get("qualification") != QUALIFICATION:
		return _reject("EXP014_A04_SOURCE_RISK_DRIFT")
	for key: String in ["source_level_id", "source_location_id", "source_region_id"]:
		var expected: String = str(plan["id"] if key == "source_level_id" else \
			plan["location_id"] if key == "source_location_id" else plan["region_id"])
		if str(regional.get_meta(key, "")) != expected:
			return _reject("EXP014_A04_SCENE_SOURCE_DRIFT")
	if str(regional.get_meta("site_signature", "")) != str(geometry["site_signature"]):
		return _reject("EXP014_A04_SCENE_GEOMETRY_DRIFT")
	if not regional.has_node("EnvironmentalEncounter"):
		return _reject("EXP014_A04_MISSING_EVIDENCE")
	var task_ids: Variant = case_source.get("source_task_ids")
	if not task_ids is Array or task_ids.size() != 5:
		return _reject("EXP014_A04_MISSING_SOURCE_TASKS")
	for i: int in range(5):
		if str(task_ids[i]) != str(plan["stations"][i]["id"]):
			return _reject("EXP014_A04_TASK_SPLICE")
	var region: String = str(plan["region_id"])
	if not PROFILES.has(region) or not CATEGORIES.has(str(plan["category"])):
		return _reject("EXP014_A04_INVALID_REGION_PROFILE")
	var profile: Dictionary = PROFILES[region]
	var clues: Variant = profile.get("clues")
	if not CLASSES.has(str(profile.get("apparatus", ""))) or \
			not clues is Array or clues.size() != 3:
		return _reject("EXP014_A04_INVALID_EVIDENCE_SEQUENCE")
	var distinct: Dictionary = {}
	for clue: Variant in clues:
		if str(clue).length() < 8 or distinct.has(clue):
			return _reject("EXP014_A04_REPEATED_EVIDENCE")
		distinct[clue] = true
	return {"ok": true, "level_id": str(plan["id"]),
		"region_id": region, "risk": str(plan["hazard"]),
		"apparatus": str(profile["apparatus"]), "source_tasks": 5,
		"evidence_stages": 3, "qualification": QUALIFICATION}


static func _material(tint: Color) -> StandardMaterial3D:
	var result: StandardMaterial3D = StandardMaterial3D.new()
	result.albedo_color = tint
	result.roughness = 0.72
	return result


static func _mesh(parent: Node3D, label: String, point: Vector3,
		size: Vector3, tint: Color) -> MeshInstance3D:
	var shape: BoxMesh = BoxMesh.new()
	shape.size = size
	var item: MeshInstance3D = MeshInstance3D.new()
	item.name = label
	item.mesh = shape
	item.material_override = _material(tint)
	item.position = point
	parent.add_child(item)
	return item


static func _fixture(parent: Node3D, apparatus: String, index: int) -> void:
	# Distinct physical schematic evidence, not just changed names/colors.
	match apparatus:
		"depth":
			_mesh(parent, "LevelRail", Vector3(0.0, 0.40, 0.0),
				Vector3(0.16, 0.8, 0.16), COLORS[0])
			_mesh(parent, "FloatMark", Vector3(0.0, 0.20 + 0.12 * index, 0.0),
				Vector3(0.35, 0.08, 0.3), COLORS[1])
		"conductivity":
			for i: int in range(2):
				_mesh(parent, "Contact%d" % i,
					Vector3(-0.19 + 0.38 * i, 0.32, 0.0),
					Vector3(0.12, 0.55, 0.14), COLORS[0])
			_mesh(parent, "InsulationBar", Vector3(0.0, 0.57, 0.0),
				Vector3(0.5, 0.09, 0.16), COLORS[1])
		"mechanical":
			_mesh(parent, "Bearing", Vector3(0.0, 0.26, 0.0),
				Vector3(0.55, 0.2, 0.55), COLORS[0])
			_mesh(parent, "StrokeWitness", Vector3(0.0, 0.54, 0.0),
				Vector3(0.1, 0.48 + 0.10 * index, 0.1), COLORS[1])
		"structure":
			_mesh(parent, "StrainFrame", Vector3(0.0, 0.37, 0.0),
				Vector3(0.54, 0.65, 0.16), COLORS[0])
			_mesh(parent, "CrossBrace", Vector3(0.0, 0.68, 0.0),
				Vector3(0.75, 0.12, 0.2), COLORS[1])
		"weather":
			_mesh(parent, "SensorMast", Vector3(0.0, 0.48, 0.0),
				Vector3(0.12, 0.96, 0.12), COLORS[0])
			_mesh(parent, "WeatherHood", Vector3(0.0, 0.96, 0.0),
				Vector3(0.65, 0.12, 0.5), COLORS[1])


## Attach to the existing A03 mesh-only region. No host registration.
static func attach(plan: Dictionary, case_source: Dictionary,
		regional: Node3D) -> Node3D:
	var gate: Dictionary = inspect(plan, case_source, regional)
	if not bool(gate.get("ok", false)) or \
			regional.has_node("EXP014_A04_EnvironmentalFeedback"):
		return null
	var scene: Node3D = Node3D.new()
	scene.name = "EXP014_A04_EnvironmentalFeedback"
	scene.set_meta("presentation_only", true)
	scene.set_meta("source_level_id", str(plan["id"]))
	scene.set_meta("source_region_id", str(plan["region_id"]))
	scene.set_meta("source_risk", str(plan["hazard"]))
	scene.set_meta("apparatus", str(gate["apparatus"]))
	scene.set_meta("qualification", QUALIFICATION)
	regional.add_child(scene)
	var profile: Dictionary = PROFILES[str(plan["region_id"])]
	var category_shift: int = CATEGORIES.find(str(plan["category"])) % 3
	for i: int in range(3):
		var station: Node3D = Node3D.new()
		station.name = "EvidenceStage%d" % i
		station.position = Vector3(-1.9 + float((i + category_shift) % 3) * 1.9,
			0.0, -1.25)
		station.set_meta("source_task_id",
			str(case_source["source_task_ids"][[0, 2, 4][i]]))
		station.set_meta("evidence_clue", str(profile["clues"][i]))
		station.set_meta("visual_state", "unverified")
		scene.add_child(station)
		_mesh(station, "Plinth", Vector3(0.0, 0.11, 0.0),
			Vector3(0.95, 0.22, 0.76), COLORS[0])
		_fixture(station, str(profile["apparatus"]), i)
		var caption: Label3D = Label3D.new()
		caption.name = "EvidenceCaption"
		caption.text = "UNVERIFIED / " + str(profile["clues"][i])
		caption.position = Vector3(0.0, 1.45, 0.0)
		caption.font_size = 25
		caption.pixel_size = 0.004
		caption.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		caption.modulate = COLORS[0]
		station.add_child(caption)
	return scene


## Host snapshots are passed in by ExpeditionMissionStage, never generated here.
## The optional contingency advances evidence only after original site success.
static func reflect(scene: Node3D, site_state: Dictionary,
		contingency_state: Dictionary = {}) -> Dictionary:
	if scene == null or not bool(scene.get_meta("presentation_only", false)) or \
			scene.get_meta("qualification") != QUALIFICATION:
		return _reject("EXP014_A04_UNTRUSTED_PRESENTATION")
	var level: String = str(scene.get_meta("source_level_id", ""))
	if level == "" or str(site_state.get("level_id", "")) != level:
		return _reject("EXP014_A04_HOST_LEVEL_MISMATCH")
	var pending: bool = not contingency_state.is_empty()
	if pending and str(contingency_state.get("level_id", "")) != level:
		return _reject("EXP014_A04_CONTINGENCY_LEVEL_MISMATCH")
	var original_solved: bool = bool(site_state.get("solved", false))
	var use_contingency: bool = pending and original_solved
	var state: Dictionary = contingency_state if use_contingency else site_state
	var route: String = str(state.get("route", ""))
	if route != "" and route not in ["priority", "resilience"]:
		return _reject("EXP014_A04_INVALID_HOST_ROUTE")
	var limit: int = 3 if use_contingency else 4
	var raw_step: Variant = state.get("step", -1)
	if typeof(raw_step) != TYPE_INT or int(raw_step) < 0 or int(raw_step) > limit:
		return _reject("EXP014_A04_INVALID_HOST_STEP")
	var step: int = int(raw_step)
	var solved: bool = bool(state.get("solved", false))
	var fault: bool = str(state.get("fault", "")) != ""
	for i: int in range(3):
		var station: Node3D = scene.get_node_or_null("EvidenceStage%d" % i) as Node3D
		if station == null:
			return _reject("EXP014_A04_MISSING_STAGE")
		var caption: Label3D = station.get_node_or_null("EvidenceCaption") as Label3D
		if caption == null:
			return _reject("EXP014_A04_MISSING_CAPTION")
		var status: String = "unverified"
		var tint_index: int = 0
		if solved or i < step:
			status = "host_verified"
			tint_index = 2
		elif i == step and route != "":
			status = "fault" if fault else "host_in_progress"
			tint_index = 3 if fault else 1
		station.set_meta("visual_state", status)
		caption.text = "%s / %s" % [status.to_upper(),
			str(station.get_meta("evidence_clue"))]
		caption.modulate = COLORS[tint_index]
	scene.set_meta("last_host_route", route)
	scene.set_meta("last_host_step", step)
	scene.set_meta("last_host_phase", "contingency" if use_contingency else "intervention")
	return {"ok": true, "authority": "READ_ONLY_PRESENTATION",
		"source_level_id": level, "phase": scene.get_meta("last_host_phase"),
		"qualification": QUALIFICATION}
