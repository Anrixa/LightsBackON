extends RefCounted
## EXP014 A04 — authored environmental evidence that follows host snapshots.
##
## Three source-risk-specific evidence stations are shown beside the A03
## environmental vignette. They do not become interaction targets or affect
## host decisions, time, physics, navigation, saves or network state.
## "Verified" is rendered only from a matching host-owned stage snapshot.

const Regional := preload("res://scripts/world/expedition_regional_facilities.gd")
const QUALIFICATION: String = "SOURCE_HEADLESS_ONLY_HUMAN_CONTROLLER_RELEASE_HELD"
const COLORS: Array[Color] = [
	Color("#536D7B"), Color("#F3C874"), Color("#72CDD2"), Color("#E26D6C")
]
const CLASSES: Array[String] = [
	"depth", "conductivity", "mechanical", "structure", "weather"
]
const CATEGORIES: Array[String] = [
	"distribution", "transport", "health", "commerce", "waterworks",
	"communications", "education", "shelter"
]

## All 25 triads are authored against the atlas hazard, not generated by
